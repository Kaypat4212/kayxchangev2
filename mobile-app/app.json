{
  "expo": {
    "name": "Trade With Kay",
    "slug": "tradewithkay",
    "description": "KayXchange crypto and finance platform, powered by the live tradewithkay.com website.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tradewithkay",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0f1419"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tradewithkay.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Use Face ID to unlock KayXchange on this device."
      }
    },
    "android": {
      "package": "com.tradewithkay.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1419"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-asset",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow KayXchange to use Face ID to unlock the app."
        }
      ]
    ],
    "extra": {
      "websiteUrl": "https://tradewithkay.com",
      "eas": {
        "projectId": "fb372d03-8920-4585-b680-7718cf3d25a2"
      }
    },
    "owner": "patrickezike66"
  }
}
